#!/usr/bin/env bash
set -euo pipefail
# worktree-setup dispatcher
hook_dir="$(cd "$(dirname "$0")" && pwd)"
if [ -x "$hook_dir/post-checkout.before-worktree-setup" ]; then
    "$hook_dir/post-checkout.before-worktree-setup" "$@"
elif git config --get filter.lfs.clean >/dev/null 2>&1; then
    git lfs post-checkout "$@"
fi
if [ "${3:-0}" = "1" ]; then
    principal="$(git worktree list --porcelain | sed -n '1s/^worktree //p')"
    setup="$principal/.githooks/worktree-setup.py"
    if [ ! -f "$setup" ]; then
        common="$(git rev-parse --path-format=absolute --git-common-dir)"
        setup="$common/worktree-setup/worktree-setup.py"
    fi
    python3 "$setup"
fi
