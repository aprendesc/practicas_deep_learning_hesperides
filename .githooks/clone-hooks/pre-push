#!/usr/bin/env bash
set -euo pipefail
hook_dir="$(cd "$(dirname "$0")" && pwd)"
refs="$(mktemp)"
trap 'rm -f "$refs"' EXIT
cat > "$refs"
python3 "$hook_dir/destination-guard.py" "$@" < "$refs"
python3 "$hook_dir/publication.py" check "$@" < "$refs"
python3 -B "$hook_dir/methodology-guard.py" pre-push "$@" < "$refs"
if git config --get filter.lfs.clean >/dev/null 2>&1; then
    git lfs pre-push "$@" < "$refs"
fi
