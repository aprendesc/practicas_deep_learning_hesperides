#!/usr/bin/env bash
set -euo pipefail
hook_dir="$(cd "$(dirname "$0")" && pwd)"
refs="$(mktemp)"
trap 'rm -f "$refs"' EXIT
cat > "$refs"
python3 "$hook_dir/destination-guard.py" "$@" < "$refs"
if [ -x "$hook_dir/pre-push.legacy" ]; then
    "$hook_dir/pre-push.legacy" "$@" < "$refs"
elif git config --get filter.lfs.clean >/dev/null 2>&1; then
    git lfs pre-push "$@" < "$refs"
fi
